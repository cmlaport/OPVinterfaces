; Run control
integrator               = md       
tinit                    = 0
dt                       = 0.004
nsteps                   = 250000000 ; 1000 ns

; Output control
nstxout                  = 2500000
nstvout                  = 2500000
nstlog                   = 1000000
nstenergy                = 1000000

; cutoffs
cutoff-scheme            = verlet
nstlist                  = 20
ns_type                  = grid
pbc                      = xyz
rlist                    = 1.2
coulombtype              = PME ;cutoff ; no charges
rcoulomb                 = 1.2
vdwtype                  = cutoff
rvdw                     = 1.2

; Temperature coupling
tcoupl			 = v-rescale
tc_grps                  = system
tau_t                    = 0.1
ref_t                    = 850

; Pressure coupling
Pcoupl                   = berendsen
tau_p                    = 1.0
compressibility          = 4.5e-05
ref_p                    = 1.0 

; bond constraints
;constraints             = none
constraint-algorithm     = lincs
